// Prisma Schema for Monetchat Marketplace
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================


enum ProductStatus {
  draft
  active
  pending
  sold
  expired
  rejected
}

enum ProductCondition {
  new
  like_new
  good
  fair
  poor
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

enum SellerStatus {
  pending
  approved
  rejected
  suspended
}

enum InquiryStatus {
  open
  responded
  closed
}

enum OrderStatus {
  draft
  pending_payment
  paid
  canceled
  expired
}

enum ReportStatus {
  pending
  reviewed
  dismissed
}

enum ReviewTargetType {
  product
  seller
}

enum EventType {
  product_created
  product_approved
  product_rejected
  inquiry_created
  seller_onboarded
  chat_search
  ai_error
}

// ============================================
// COUNTRIES & REGIONS
// ============================================

model Country {
  code           String   @id @db.Char(2)
  name           String   @db.VarChar(100)
  nameAr         String   @map("name_ar") @db.VarChar(100)
  currencyCode   String   @map("currency_code") @db.Char(3)
  currencySymbol String?  @map("currency_symbol") @db.VarChar(5)
  phoneCode      String   @map("phone_code") @db.VarChar(5)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  regions  Region[]
  users    User[]
  products Product[]

  @@map("countries")
}

model Region {
  id          Int      @id @default(autoincrement())
  countryCode String   @map("country_code") @db.Char(2)
  name        String   @db.VarChar(100)
  nameAr      String   @map("name_ar") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")

  // Relations
  country  Country   @relation(fields: [countryCode], references: [code])
  users    User[]
  products Product[]

  @@map("regions")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  name              String    @db.VarChar(100)
  nameAr            String?   @map("name_ar") @db.VarChar(100)
  phone             String?   @db.VarChar(20)
  nationalId        String?   @map("national_id") @db.VarChar(20)
  avatarUrl         String?   @map("avatar_url") @db.VarChar(512)
  roleId            String    @map("role_id")
  role              Role      @relation(fields: [roleId], references: [id])
  countryCode       String    @default("KW") @map("country_code") @db.Char(2)
  regionId          Int?      @map("region_id")
  preferredLanguage String    @default("ar") @map("preferred_language") @db.Char(2)
  verificationToken      String?   @map("verification_token") @db.VarChar(255)
  verificationTokenExpires DateTime? @map("verification_token_expires")
  resetToken               String?   @map("reset_token") @db.VarChar(255)
  resetTokenExpires        DateTime? @map("reset_token_expires")
  isVerified               Boolean   @default(false) @map("is_verified")
  isActive                 Boolean   @default(true) @map("is_active")
  lastLoginAt              DateTime? @map("last_login_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")
  createdById              String?   @map("created_by_id")
  updatedById              String?   @map("updated_by_id")

  // Relations
  country      Country       @relation(fields: [countryCode], references: [code])
  region       Region?       @relation(fields: [regionId], references: [id])
  seller       Seller?
  chatSessions ChatSession[]
  searchLogs   SearchLog[]
  contactLogs  ContactLog[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  attachments   Attachment[]
  favorites     Favorite[]
  buyerInquiries Inquiry[]    @relation("InquiryBuyer")
  sellerInquiries Inquiry[]   @relation("InquirySeller")
  buyerOrders    Order[]      @relation("OrderBuyer")
  sellerOrders   Order[]      @relation("OrderSeller")
  reportedItems  Report[]     @relation("ReportReporter")
  authoredReviews Review[]
  sellerReviews   Review[]    @relation("ReviewSeller")
  eventLogs       EventLog[]

  // Audit Relations
  creator       User?     @relation("UserAuditCreator", fields: [createdById], references: [id])
  createdBy     User[]    @relation("UserAuditCreator")
  updator       User?     @relation("UserAuditUpdator", fields: [updatedById], references: [id])
  updatedBy     User[]    @relation("UserAuditUpdator")

  // Other entities audit relations
  createdRoles       Role[]       @relation("RoleCreator")
  updatedRoles       Role[]       @relation("RoleUpdator")
  createdPermissions Permission[] @relation("PermissionCreator")
  updatedPermissions Permission[] @relation("PermissionUpdator")
  createdCategories  Category[]   @relation("CategoryCreator")
  updatedCategories  Category[]   @relation("CategoryUpdator")
  createdProducts    Product[]    @relation("ProductCreator")
  updatedProducts    Product[]    @relation("ProductUpdator")
  createdSellers     Seller[]     @relation("SellerCreator")
  updatedSellers     Seller[]     @relation("SellerUpdator")

  @@index([email])
  @@index([countryCode])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================
// SELLERS
// ============================================

model Seller {
  userId         String   @id @map("user_id")
  businessName   String?  @map("business_name") @db.VarChar(255)
  businessNameAr String?  @map("business_name_ar") @db.VarChar(255)
  bio            String?  @db.Text
  bioAr          String?  @map("bio_ar") @db.Text
  phonePublic    String   @map("phone_public") @db.VarChar(20)
  whatsappNumber String?  @map("whatsapp_number") @db.VarChar(20)
  rating         Decimal  @default(0.00) @db.Decimal(3, 2)
  totalReviews   Int      @default(0) @map("total_reviews")
  totalSales     Int      @default(0) @map("total_sales")
  isVerified         Boolean  @default(false) @map("is_verified")
  isProfileComplete  Boolean  @default(false) @map("is_profile_complete")
  status             SellerStatus @default(pending)
  statusReason       String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  createdById        String?   @map("created_by_id")
  updatedById        String?   @map("updated_by_id")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  creator  User?     @relation("SellerCreator", fields: [createdById], references: [id])
  updator  User?     @relation("SellerUpdator", fields: [updatedById], references: [id])

  @@map("sellers")
}

// ============================================
// CATEGORIES
// ============================================

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(100)
  nameAr    String    @map("name_ar") @db.VarChar(100)
  parentId  Int?      @map("parent_id")
  icon      String?   @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  // Relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  creator  User?      @relation("CategoryCreator", fields: [createdById], references: [id])
  updator  User?      @relation("CategoryUpdator", fields: [updatedById], references: [id])

  @@map("categories")
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id              String           @id @default(uuid())
  sellerId        String           @map("seller_id")

  // Content
  title           String           @db.VarChar(255)
  titleAr         String?          @map("title_ar") @db.VarChar(255)
  description     String?          @db.Text
  descriptionAr   String?          @map("description_ar") @db.Text

  // Pricing
  price           Decimal          @db.Decimal(12, 2)
  currency        String           @default("KWD") @db.Char(3)
  isNegotiable    Boolean          @default(true) @map("is_negotiable")

  // Category (AI-assigned)
  categoryId      Int?             @map("category_id")

  // Location
  countryCode     String           @default("KW") @map("country_code") @db.Char(2)
  regionId        Int?             @map("region_id")
  latitude        Decimal?         @db.Decimal(10, 8)
  longitude       Decimal?         @db.Decimal(11, 8)

  // Status
  status          ProductStatus    @default(pending)
  rejectionReason String?          @map("rejection_reason") @db.Text
  condition       ProductCondition @default(good)

  // Metadata
  viewCount       Int              @default(0) @map("view_count")
  contactCount    Int              @default(0) @map("contact_count")

  // Vector reference (stored in Qdrant)
  qdrantPointId   String?          @map("qdrant_point_id")

  // Timestamps
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  expiresAt       DateTime         @default(dbgenerated("NOW() + INTERVAL '30 days'")) @map("expires_at")
  createdById     String?          @map("created_by_id")
  updatedById     String?          @map("updated_by_id")

  // Relations
  seller      Seller         @relation(fields: [sellerId], references: [userId], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id])
  country     Country        @relation(fields: [countryCode], references: [code])
  region      Region?        @relation(fields: [regionId], references: [id])
  images      ProductImage[]
  contactLogs ContactLog[]
  favorites   Favorite[]
  inquiries   Inquiry[]
  orders      Order[]
  reviews     Review[]
  creator     User?          @relation("ProductCreator", fields: [createdById], references: [id])
  updator     User?          @relation("ProductUpdator", fields: [updatedById], references: [id])

  @@index([sellerId])
  @@index([categoryId])
  @@index([countryCode])
  @@index([status])
  @@index([price])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String   @db.VarChar(512)
  s3Key     String   @map("s3_key") @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ============================================
// CHAT SESSIONS (AI Conversations)
// ============================================

model ChatSession {
  id            String        @id @default(uuid())
  userId        String?       @map("user_id")
  sessionToken  String?       @unique @map("session_token") @db.VarChar(255)
  title         String?       @db.VarChar(100)
  countryCode   String        @default("KW") @map("country_code") @db.Char(2)
  language      String        @default("ar") @db.Char(2)
  createdAt     DateTime      @default(now()) @map("created_at")
  lastMessageAt DateTime      @default(now()) @map("last_message_at")

  // Relations
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    ChatMessage[]
  searchLogs  SearchLog[]
  contactLogs ContactLog[]

  @@index([userId, lastMessageAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  role            String   @db.VarChar(20) // 'user', 'assistant'
  content         String   @db.Text

  // For user messages
  hasImage        Boolean  @default(false) @map("has_image")
  imageUrl        String?  @map("image_url") @db.VarChar(512)
  hasVoice        Boolean  @default(false) @map("has_voice")
  voiceTranscript String?  @map("voice_transcript") @db.Text

  // For assistant messages - stored as JSON array of UUIDs
  productIds      String[] @map("product_ids")

  // Structured metadata for drafts & published confirmations
  metadata        Json?    @map("metadata")

  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ============================================
// CONTENT MODERATION
// ============================================

model ProhibitedKeyword {
  id           Int      @id @default(autoincrement())
  keyword      String   @db.VarChar(100)
  keywordAr    String?  @map("keyword_ar") @db.VarChar(100)
  countryCodes String[] @default(["KW", "SA"]) @map("country_codes")
  category     String?  @db.VarChar(50) // 'alcohol', 'weapons', 'drugs', etc.
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("prohibited_keywords")
}

// ============================================
// ROLES & PERMISSIONS
// ============================================

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  createdById String?          @map("created_by_id")
  updatedById String?          @map("updated_by_id")

  creator     User?            @relation("RoleCreator", fields: [createdById], references: [id])
  updator     User?            @relation("RoleUpdator", fields: [updatedById], references: [id])

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  createdById String?          @map("created_by_id")
  updatedById String?          @map("updated_by_id")

  creator     User?            @relation("PermissionCreator", fields: [createdById], references: [id])
  updator     User?            @relation("PermissionUpdator", fields: [updatedById], references: [id])

  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// ANALYTICS & LOGS
// ============================================

model SearchLog {
  id          BigInt      @id @default(autoincrement())
  sessionId   String?     @map("session_id")
  userId      String?     @map("user_id")
  queryText   String?     @map("query_text") @db.Text
  queryType   String?     @map("query_type") @db.VarChar(20) // 'text', 'voice', 'image'
  filters     Json?
  resultCount Int?        @map("result_count")
  latencyMs   Int?        @map("latency_ms")
  countryCode String?     @map("country_code") @db.Char(2)
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  session ChatSession? @relation(fields: [sessionId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])

  @@map("search_logs")
}

model ContactLog {
  id          BigInt      @id @default(autoincrement())
  productId   String?     @map("product_id")
  userId      String?     @map("user_id")
  sessionId   String?     @map("session_id")
  contactType String?     @map("contact_type") @db.VarChar(20) // 'call', 'whatsapp'
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  product Product?     @relation(fields: [productId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])
  session ChatSession? @relation(fields: [sessionId], references: [id])

  @@map("contact_logs")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id          String      @id @default(uuid())
  entityName  String      @map("entity_name")
  entityId    String      @map("entity_id")
  action      AuditAction
  userId      String?     @map("user_id")
  changes     Json?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  body      String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// ATTACHMENTS
// ============================================

model Attachment {
  id          String   @id @default(uuid())
  fileName    String   @map("file_name")
  fileType    String   @map("file_type")
  fileSize    Int      @map("file_size")
  url         String
  s3Key       String?  @map("s3_key")
  entityType  String?  @map("entity_type") // e.g., 'Product', 'User'
  entityId    String?  @map("entity_id")
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("attachments")
}

// ============================================
// NOTIFICATION JOBS (QUEUE)
// ============================================

model NotificationJob {
  id        String   @id @default(uuid())
  type      String   // e.g., 'email', 'system'
  payload   Json     // contains user id, message, etc.
  status    String   // 'pending', 'processing', 'completed', 'failed'
  error     String?  @db.Text
  retryCount Int     @default(0) @map("retry_count")
  runAt     DateTime @default(now()) @map("run_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("notification_jobs")
}

// ============================================
// FAVORITES
// ============================================

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

// ============================================
// INQUIRIES (Buyer → Seller about Product)
// ============================================

model Inquiry {
  id         String        @id @default(uuid())
  productId  String        @map("product_id")
  buyerId    String        @map("buyer_id")
  sellerId   String        @map("seller_id")
  status     InquiryStatus @default(open)
  message    String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation("InquiryBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("InquirySeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([productId, status])
  @@map("inquiries")
}

// ============================================
// ORDERS (foundation for future checkout)
// ============================================

model Order {
  id          String      @id @default(uuid())
  buyerId     String      @map("buyer_id")
  sellerId    String      @map("seller_id")
  productId   String      @map("product_id")
  status      OrderStatus @default(draft)
  price       Decimal     @db.Decimal(12, 2)
  currency    String      @db.Char(3)
  quantity    Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  expiresAt   DateTime?   @map("expires_at")
  metadata    Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([productId, status])
  @@map("orders")
}

// ============================================
// REPORTS (abuse / flagging)
// ============================================

model Report {
  id          String       @id @default(uuid())
  reporterId  String       @map("reporter_id")
  targetType  String       @map("target_type") // 'product' | 'seller'
  targetId    String       @map("target_id")
  reason      String       @db.VarChar(100)
  notes       String?      @db.Text
  status      ReportStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at")
  reviewedAt  DateTime?    @map("reviewed_at")
  reviewedBy  String?      @map("reviewed_by")

  reporter User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([reporterId, targetType, targetId])
  @@map("reports")
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id          String           @id @default(uuid())
  reviewerId  String           @map("reviewer_id")
  targetType  ReviewTargetType @map("target_type")
  productId   String?          @map("product_id")
  sellerId    String?          @map("seller_id")
  rating      Int              @db.SmallInt
  comment     String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")

  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller   User?   @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([targetType, productId])
  @@index([targetType, sellerId])
  @@unique([reviewerId, productId])
  @@unique([reviewerId, sellerId])
  @@map("reviews")
}

// ============================================
// EVENT LOGS (lightweight analytics/observability)
// ============================================

model EventLog {
  id        String    @id @default(uuid())
  type      EventType
  userId    String?   @map("user_id")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@map("event_logs")
}
