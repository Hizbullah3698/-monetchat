// Prisma Schema for Monetchat Marketplace
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  buyer
  seller
}

enum ProductStatus {
  active
  sold
  expired
  rejected
}

enum ProductCondition {
  new
  like_new
  good
  fair
  poor
}

// ============================================
// COUNTRIES & REGIONS
// ============================================

model Country {
  code           String   @id @db.Char(2)
  name           String   @db.VarChar(100)
  nameAr         String   @map("name_ar") @db.VarChar(100)
  currencyCode   String   @map("currency_code") @db.Char(3)
  currencySymbol String?  @map("currency_symbol") @db.VarChar(5)
  phoneCode      String   @map("phone_code") @db.VarChar(5)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  regions  Region[]
  users    User[]
  products Product[]

  @@map("countries")
}

model Region {
  id          Int      @id @default(autoincrement())
  countryCode String   @map("country_code") @db.Char(2)
  name        String   @db.VarChar(100)
  nameAr      String   @map("name_ar") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")

  // Relations
  country  Country   @relation(fields: [countryCode], references: [code])
  users    User[]
  products Product[]

  @@map("regions")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  name              String    @db.VarChar(100)
  nameAr            String?   @map("name_ar") @db.VarChar(100)
  phone             String?   @db.VarChar(20)
  nationalId        String?   @map("national_id") @db.VarChar(20)
  avatarUrl         String?   @map("avatar_url") @db.VarChar(512)
  role              UserRole  @default(buyer)
  countryCode       String    @default("KW") @map("country_code") @db.Char(2)
  regionId          Int?      @map("region_id")
  preferredLanguage String    @default("ar") @map("preferred_language") @db.Char(2)
  isVerified        Boolean   @default(false) @map("is_verified")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  country      Country       @relation(fields: [countryCode], references: [code])
  region       Region?       @relation(fields: [regionId], references: [id])
  seller       Seller?
  chatSessions ChatSession[]
  searchLogs   SearchLog[]
  contactLogs  ContactLog[]

  @@index([email])
  @@index([countryCode])
  @@map("users")
}

// ============================================
// SELLERS
// ============================================

model Seller {
  userId         String   @id @map("user_id")
  businessName   String?  @map("business_name") @db.VarChar(255)
  businessNameAr String?  @map("business_name_ar") @db.VarChar(255)
  bio            String?  @db.Text
  bioAr          String?  @map("bio_ar") @db.Text
  phonePublic    String   @map("phone_public") @db.VarChar(20)
  whatsappNumber String?  @map("whatsapp_number") @db.VarChar(20)
  rating         Decimal  @default(0.00) @db.Decimal(3, 2)
  totalReviews   Int      @default(0) @map("total_reviews")
  totalSales     Int      @default(0) @map("total_sales")
  isVerified         Boolean  @default(false) @map("is_verified")
  isProfileComplete  Boolean  @default(false) @map("is_profile_complete")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("sellers")
}

// ============================================
// CATEGORIES
// ============================================

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(100)
  nameAr    String    @map("name_ar") @db.VarChar(100)
  parentId  Int?      @map("parent_id")
  icon      String?   @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")

  // Relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id              String           @id @default(uuid())
  sellerId        String           @map("seller_id")

  // Content
  title           String           @db.VarChar(255)
  titleAr         String?          @map("title_ar") @db.VarChar(255)
  description     String?          @db.Text
  descriptionAr   String?          @map("description_ar") @db.Text

  // Pricing
  price           Decimal          @db.Decimal(12, 2)
  currency        String           @default("KWD") @db.Char(3)
  isNegotiable    Boolean          @default(true) @map("is_negotiable")

  // Category (AI-assigned)
  categoryId      Int?             @map("category_id")

  // Location
  countryCode     String           @default("KW") @map("country_code") @db.Char(2)
  regionId        Int?             @map("region_id")
  latitude        Decimal?         @db.Decimal(10, 8)
  longitude       Decimal?         @db.Decimal(11, 8)

  // Status
  status          ProductStatus    @default(active)
  rejectionReason String?          @map("rejection_reason") @db.Text
  condition       ProductCondition @default(good)

  // Metadata
  viewCount       Int              @default(0) @map("view_count")
  contactCount    Int              @default(0) @map("contact_count")

  // Vector reference (stored in Qdrant)
  qdrantPointId   String?          @map("qdrant_point_id")

  // Timestamps
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  expiresAt       DateTime         @default(dbgenerated("NOW() + INTERVAL '30 days'")) @map("expires_at")

  // Relations
  seller      Seller         @relation(fields: [sellerId], references: [userId], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id])
  country     Country        @relation(fields: [countryCode], references: [code])
  region      Region?        @relation(fields: [regionId], references: [id])
  images      ProductImage[]
  contactLogs ContactLog[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([countryCode])
  @@index([status])
  @@index([price])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String   @db.VarChar(512)
  s3Key     String   @map("s3_key") @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ============================================
// CHAT SESSIONS (AI Conversations)
// ============================================

model ChatSession {
  id            String        @id @default(uuid())
  userId        String?       @map("user_id")
  sessionToken  String?       @unique @map("session_token") @db.VarChar(255)
  title         String?       @db.VarChar(100)
  countryCode   String        @default("KW") @map("country_code") @db.Char(2)
  language      String        @default("ar") @db.Char(2)
  createdAt     DateTime      @default(now()) @map("created_at")
  lastMessageAt DateTime      @default(now()) @map("last_message_at")

  // Relations
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    ChatMessage[]
  searchLogs  SearchLog[]
  contactLogs ContactLog[]

  @@index([userId, lastMessageAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  role            String   @db.VarChar(20) // 'user', 'assistant'
  content         String   @db.Text

  // For user messages
  hasImage        Boolean  @default(false) @map("has_image")
  imageUrl        String?  @map("image_url") @db.VarChar(512)
  hasVoice        Boolean  @default(false) @map("has_voice")
  voiceTranscript String?  @map("voice_transcript") @db.Text

  // For assistant messages - stored as JSON array of UUIDs
  productIds      String[] @map("product_ids")

  // Structured metadata for drafts & published confirmations
  metadata        Json?    @map("metadata")

  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ============================================
// CONTENT MODERATION
// ============================================

model ProhibitedKeyword {
  id           Int      @id @default(autoincrement())
  keyword      String   @db.VarChar(100)
  keywordAr    String?  @map("keyword_ar") @db.VarChar(100)
  countryCodes String[] @default(["KW", "SA"]) @map("country_codes")
  category     String?  @db.VarChar(50) // 'alcohol', 'weapons', 'drugs', etc.
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("prohibited_keywords")
}

// ============================================
// ANALYTICS & LOGS
// ============================================

model SearchLog {
  id          BigInt      @id @default(autoincrement())
  sessionId   String?     @map("session_id")
  userId      String?     @map("user_id")
  queryText   String?     @map("query_text") @db.Text
  queryType   String?     @map("query_type") @db.VarChar(20) // 'text', 'voice', 'image'
  filters     Json?
  resultCount Int?        @map("result_count")
  latencyMs   Int?        @map("latency_ms")
  countryCode String?     @map("country_code") @db.Char(2)
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  session ChatSession? @relation(fields: [sessionId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])

  @@map("search_logs")
}

model ContactLog {
  id          BigInt      @id @default(autoincrement())
  productId   String?     @map("product_id")
  userId      String?     @map("user_id")
  sessionId   String?     @map("session_id")
  contactType String?     @map("contact_type") @db.VarChar(20) // 'call', 'whatsapp'
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  product Product?     @relation(fields: [productId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])
  session ChatSession? @relation(fields: [sessionId], references: [id])

  @@map("contact_logs")
}
