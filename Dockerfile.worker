FROM node:20-alpine
WORKDIR /app

# Install openssl for Prisma
RUN apk add --no-cache openssl curl

COPY package*.json ./
RUN npm install

COPY . .

# Generate prisma client
RUN npx prisma generate

ENV NODE_ENV=production

# Expose Bull board port
EXPOSE 4501

CMD ["npx", "tsx", "scripts/start-worker.ts"]
