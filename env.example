# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:9002
PORT=3000

# ============================================
# POSTGRESQL (Prisma)
# ============================================
DATABASE_URL=postgresql://Monetchat_user:password@localhost:5432/Monetchat

# ============================================
# QDRANT (Vector Database)
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================
# AWS S3 (Image Storage)
# ============================================
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=Monetchat-media
S3_CDN_URL=https://Monetchat-media.s3.me-south-1.amazonaws.com

# ============================================
# AI PROVIDERS (Ollama)
# ============================================
EMBEDDING_PROVIDER=ollama
CHAT_PROVIDER=ollama
# Use a remote Ollama base URL (root only). Example: RunPod proxy URL.
OLLAMA_BASE_URL=https://<your-pod-id>-8000.proxy.runpod.net
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct-q8_0
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava
RUNPOD_BASE_URL=https://<your-pod-id>-8000.proxy.runpod.net
GROQ_API_KEY= # Optional, for Whisper Voice Transcriptions only.

# ============================================
# JWT AUTH
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=24h

# ============================================
# REGIONAL DEFAULTS
# ============================================
DEFAULT_COUNTRY=KW
DEFAULT_CURRENCY=KWD
DEFAULT_LANGUAGE=ar
